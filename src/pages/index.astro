---
import ReactCounter from '@/components/react/ReactCounter.tsx'
import SolidCounter from '@/components/solid/SolidCounter.tsx'
import SvelteCounter from '@/components/svelte/SvelteCounter.svelte'
import ThemeToggle from '@/components/ThemeToggle.astro'
import VueCounter from '@/components/vue/VueCounter.vue'
import DefaultLayout from '@/layouts/default.astro';
---

<DefaultLayout>
  <div class="min-h-screen bg-gray-50 dark:bg-gray-900 py-12 px-4 sm:px-6 lg:px-8">
    <div class="max-w-4xl mx-auto space-y-8">
      <div class="text-center space-y-4">
        <h1 class="text-4xl font-extrabold text-gray-900 dark:text-white tracking-tight sm:text-5xl">
          Astro Starter Kit
        </h1>
        <p class="text-lg text-gray-600 dark:text-gray-400 max-w-2xl mx-auto">
          Multi-framework support with <span class="font-semibold text-blue-600 dark:text-blue-400">React</span>, <span class="font-semibold text-green-600 dark:text-green-400">Vue</span>, <span class="font-semibold text-orange-600 dark:text-orange-400">Svelte</span>, and <span class="font-semibold text-teal-600 dark:text-teal-400">Solid</span>. Powered by Ark UI and Tailwind v4.
        </p>
        <div class="flex justify-center pt-2">
          <ThemeToggle />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <VueCounter client:only="vue" />
        <ReactCounter client:only="react" />
        <SvelteCounter client:only="svelte" />
        <SolidCounter client:only="solid-js" />
      </div>
    </div>
  </div>
</DefaultLayout>
