{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    // Leave JSX untransformed so each framework's Vite plugin compiles it.
    // React and Solid files declare `/** @jsxImportSource ... */` per file.
    "jsx": "preserve",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"]
}
