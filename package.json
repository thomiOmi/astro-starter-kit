{
  "name": "astro-starter-kit",
  "type": "module",
  "version": "0.0.1",
  "description": "Multi-framework Astro starter kit with React, Vue, Svelte, Solid, Ark UI and Tailwind CSS.",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "astro check",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@ark-ui/react": "^5.30.0",
    "@ark-ui/solid": "^5.30.0",
    "@ark-ui/svelte": "^5.15.0",
    "@ark-ui/vue": "^5.30.0",
    "@astrojs/check": "^0.9.12",
    "@astrojs/react": "^7.1.7",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/solid-js": "^7.1.4",
    "@astrojs/svelte": "^9.1.4",
    "@astrojs/vue": "^7.1.4",
    "@iconify-json/lucide": "^1.2.86",
    "@iconify/react": "^6.0.2",
    "@iconify/svelte": "^5.2.1",
    "@iconify/vue": "^5.0.0",
    "@nanostores/react": "^2.0.1",
    "@nanostores/solid": "^1.1.1",
    "@nanostores/vue": "^1.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.2.9",
    "@types/react-dom": "^19.2.3",
    "@vueuse/core": "^15.0.0",
    "astro": "^7.4.10",
    "astro-icon": "^1.2.0",
    "nanostores": "^1.1.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "solid-js": "^1.9.18",
    "svelte": "^5.48.0",
    "tailwindcss": "^4.3.5",
    "vue": "^3.5.45"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@eslint-react/eslint-plugin": "^5.30.1",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-format": "^2.0.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-solid": "^0.17.1",
    "eslint-plugin-svelte": "^3.14.0",
    "eslint-plugin-vuejs-accessibility": "^2.4.1",
    "lint-staged": "^17.6.0",
    "simple-git-hooks": "^2.14.0",
    "typescript": "^6.0.3"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "allowScripts": {
    "simple-git-hooks": true
  }
}
